{
  "name": "sparklogs-ai-plugins",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "build": "node scripts/render-packages.mjs --out build/dist",
    "build:claude": "node scripts/render-packages.mjs --out build/dist --host claude",
    "build:cursor": "node scripts/render-packages.mjs --out build/dist --host cursor",
    "build:codex": "node scripts/render-packages.mjs --out build/dist --host codex",
    "build:generic": "node scripts/render-packages.mjs --out build/dist --host generic",
    "sync-generated": "node scripts/sync-generated-references.mjs",
    "stitch-indexes": "node scripts/stitch-indexes.mjs",
    "validate:generated": "node scripts/lint-generated-references.mjs && node scripts/sync-generated-references.mjs --check",
    "validate": "node scripts/lint-src-layout.mjs && node scripts/stitch-indexes.mjs --check && node scripts/validate-skills.mjs && yarn run validate:generated && yarn run build && node scripts/validate-rendered.mjs build/dist && node scripts/render-packages.mjs --out build/repro-a && node scripts/render-packages.mjs --out build/repro-b && diff -qr build/repro-a build/repro-b",
    "validate:rendered": "node scripts/validate-rendered.mjs build/dist",
    "validate:cursor": "node scripts/validate-cursor-plugin.mjs build/dist",
    "smoke": "node scripts/smoke-test-packages.mjs build/dist",
    "clean": "node scripts/clean.mjs",
    "fullrebuild": "yarn run clean && yarn run validate && yarn run build && yarn run validate:rendered && yarn run validate:cursor && yarn run smoke",
    "compare-dist": "node scripts/compare-dist-branch.mjs"
  },
  "resolutions": {
    "ip-address": "10.1.1",
    "js-yaml": "4.2.0"
  },
  "devDependencies": {
    "js-yaml": "4.2.0"
  }
}
